# ==============================================================================
# Kirana Khata (Voice-First Ledger & Razorpay Rails) - Environment Configuration
# Copy this file to .env and fill in your values. DO NOT commit .env to GitHub!
# ==============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Default is local SQLite. In production, use PostgreSQL (e.g. Supabase, Neon, Railway)
# Example: postgresql://user:password@ep-cool-db.us-east-1.aws.neon.tech/kiranadb?sslmode=require
DATABASE_URL=sqlite:///./ledger.db

# ── AI Provider Selection ─────────────────────────────────────────────────────
# Options: "mock" (offline regex/deterministic), "openai" (GPT-4o mini), "groq" (Llama 3)
ASR_PROVIDER=mock
LLM_PROVIDER=mock

# ── API Keys (Only required if provider is NOT "mock") ────────────────────────
OPENAI_API_KEY=
GROQ_API_KEY=

# ── Store / Merchant Information ──────────────────────────────────────────────
MERCHANT_VPA=sharmakirana@upi
MERCHANT_NAME=Sharma Kirana Store
DEMO_MERCHANT_ID=a1b2c3d4-e5f6-7890-abcd-ef1234567890

# ── JWT Authentication Security ───────────────────────────────────────────────
# Generate a strong random key in production: openssl rand -hex 32
JWT_SECRET_KEY=voice-ledger-secret-jwt-key-sharma-kirana-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
PASSWORD_RESET_EXPIRE_MINUTES=15

# ── Razorpay Payment Rails & Webhooks ─────────────────────────────────────────
# Get these from https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=whsec_your_webhook_secret

# ── Email / SMTP Configuration (Forgot Password Service) ──────────────────────
# If left blank, the app runs in demo mode with an in-app simulated mailbox preview
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAILS_FROM=support@kirana-khata.in
SMTP_USE_TLS=true

# ── CORS / Frontend URL ───────────────────────────────────────────────────────
# Localhost dev or your deployed Vercel domain (e.g. https://my-kirana-khata.vercel.app)
FRONTEND_ORIGIN=http://localhost:5173
